# Media Extended ships NO licence upstream — no LICENSE file, no package.json
# `license` field — so nobody has been granted redistribution rights. Its code
# is deliberately not distributed; users install it from Obsidian's community
# browser and pick up our data.json settings. Do not re-add these if a local
# install puts them back. See THIRD-PARTY-NOTICES.md.
.obsidian/plugins/media-extended/main.js
.obsidian/plugins/media-extended/manifest.json
.obsidian/plugins/media-extended/styles.css

# Per-vault backups written by the framework updater (99 - Meta/04 - Tooling)
99 - Meta/05 - Backups/

# Research notes are a local-only working surface. Docs and ADRs cite them by
# filename for provenance, but the notes themselves are never published.
research/
